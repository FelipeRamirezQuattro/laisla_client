# Development:
# VITE_API_BASE_URL=http://localhost:4000/api

# Production: replace api.laislacafepicnic.com with the EC2/API domain when defined.
VITE_API_BASE_URL=https://api.laislacafepicnic.com/api

# Google SSO OAuth Web Client ID. Must match backend GOOGLE_CLIENT_ID.
VITE_GOOGLE_CLIENT_ID=

# Cloudflare Turnstile site key (Cloudflare dashboard > Turnstile > your
# widget). Matching secret key goes in backend/.env as
# TURNSTILE_SECRET_KEY. Left empty, the newsletter subscribe form skips
# the captcha widget (local dev without a Cloudflare account).
VITE_TURNSTILE_SITE_KEY=
